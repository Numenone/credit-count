# Supabase project settings → API. Both values are safe to expose to the browser:
# the anon key only grants what RLS allows.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Used only by scripts/verify-security.mjs, never by the app. Optional.
E2E_ENTHUSIAST_EMAIL=
E2E_ENTHUSIAST_PASSWORD=
E2E_SECOND_USER_EMAIL=
E2E_SECOND_USER_PASSWORD=
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
